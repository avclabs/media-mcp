{
  "type": "module",
  "name": "@avclabs.ai/image-mcp",
  "version": "0.1.1",
  "description": "MCP server for AVCLabs image enhancement, colorization, and denoising: enhance_image_sync, colorize_image_sync, denoise_image_sync, get_image_task_status",
  "mcpName": "io.github.avclabs/image-mcp",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "image-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "config.json",
    "LICENSE",
    "README.md",
    "README_CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image",
    "enhancement",
    "colorization",
    "denoising",
    "server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avclabs/media-mcp.git",
    "directory": "packages/image-mcp"
  },
  "dependencies": {
    "@avclabs.ai/media-mcp-core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.0",
    "zod": "^3.23.0"
  },
  "mcpServer": {
    "command": "npx",
    "args": [
      "-y",
      "-p",
      "@avclabs.ai/image-mcp",
      "image-mcp"
    ],
    "env": {
      "API_KEY": "your-api-key",
      "IMAGE_API_BASE_URL": "https://mcp.avc.ai/enhance"
    },
    "description": "AVCLabs \u56fe\u7247\u589e\u5f3a/\u4e0a\u8272/\u964d\u566a MCP \u670d\u52a1\uff08enhance_image_sync / colorize_image_sync / denoise_image_sync / get_image_task_status\uff09",
    "setup": "\u9700\u8981\u66ff\u6362 env.API_KEY \u4e3a\u4f60\u7684 API Key\u3002IMAGE_API_BASE_URL \u4e0d\u8bbe\u7f6e\u65f6\u81ea\u52a8\u56de\u843d\u5230\u589e\u5f3a\u670d\u52a1\u5730\u5740"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
