{
  "type": "module",
  "name": "@avclabs.ai/media-mcp",
  "version": "0.4.1",
  "description": "Legacy all-in-one MCP Server for video enhancement, image enhancement/colorization/denoising, and image segmentation (SAM3). Prefer the per-function packages @avclabs.ai/video-mcp, @avclabs.ai/image-mcp, and @avclabs.ai/sam3-mcp.",
  "mcpName": "io.github.avclabs/media-mcp",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "media-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "config.json",
    "LICENSE",
    "README.md",
    "README_CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "image",
    "enhancement",
    "colorization",
    "denoising",
    "server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avclabs/media-mcp.git",
    "directory": "packages/media-mcp"
  },
  "dependencies": {
    "@avclabs.ai/media-mcp-core": "^0.1.0",
    "@avclabs.ai/video-mcp": "^0.1.0",
    "@avclabs.ai/image-mcp": "^0.1.0",
    "@avclabs.ai/sam3-mcp": "^0.1.0"
  },
  "mcpServer": {
    "command": "npx",
    "args": [
      "-y",
      "@avclabs.ai/media-mcp@latest"
    ],
    "env": {
      "API_KEY": "your-api-key",
      "HTTP_API_BASE_URL": "https://mcp.avc.ai/enhance",
      "SAM3_API_BASE_URL": "https://mcp.avc.ai/sam"
    },
    "description": "\u89c6\u9891\u589e\u5f3a + \u56fe\u7247\u589e\u5f3a/\u4e0a\u8272/\u964d\u566a + SAM3 \u56fe\u50cf\u5206\u5272 MCP \u670d\u52a1\uff08\u5168\u91cf 9 \u5de5\u5177\uff1b\u63a8\u8350\u6539\u7528\u6309\u529f\u80fd\u62c6\u5206\u7684 video-mcp / image-mcp / sam3-mcp\uff09",
    "setup": "\u9700\u8981\u66ff\u6362 env.API_KEY \u4e3a\u4f60\u7684 API Key"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
