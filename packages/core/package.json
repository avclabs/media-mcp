{
  "name": "@avclabs.ai/media-mcp-core",
  "version": "0.1.0",
  "description": "Shared toolkit for the AVCLabs media MCP servers: tool registration, task polling, TOS upload, and host config resolution",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
